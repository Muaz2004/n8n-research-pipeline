    {
      "parameters": {
        "jsCode": "const subject = $json.Subject || $json.subject || '';\nconst snippet = $json.snippet || $json.textPlain || $json.textHtml || '';\nconst newReplyText = snippet.split(/On\\s+.*wrote:/i)[0].trim();\nconst requestIdMatch = subject.match(/REQ-\\d+/i) || newReplyText.match(/REQ-\\d+/i);\nconst requestId = requestIdMatch ? requestIdMatch[0].toUpperCase() : '';\nconst normalized = newReplyText.trim();\nconst upper = normalized.toUpperCase();\nlet responseType = 'UNKNOWN';\nlet feedbackText = '';\n\nif (upper.startsWith('APPROVED') || upper.includes('\\nAPPROVED')) {\n  responseType = 'APPROVED';\n} else {\n  const feedbackMatch = normalized.match(/FEEDBACK:\\s*([\\s\\S]*)/i);\n  if (feedbackMatch) {\n    responseType = 'FEEDBACK';\n    feedbackText = feedbackMatch[1].trim();\n  }\n}\n\nreturn [{\n  json: {\n    requestId,\n    responseType,\n    feedbackText,\n    replyText: normalized,\n    subject\n  }\n}];"
      },
