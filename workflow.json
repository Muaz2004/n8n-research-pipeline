{
  "name": "Research Pipeline - Trigger, Tavily Search, LLM Report & Email Review",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "research-request",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "1d8b671a-2895-46f9-b883-8a0a9829f001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        340
      ],
      "webhookId": "research-request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"api_key\": \"{{ $env.TAVILY_API_KEY || 'YOUR_TAVILY_API_KEY' }}\",\n  \"query\": \"{{ $json.body?.topic || $json.topic }}\",\n  \"search_depth\": \"advanced\",\n  \"include_answer\": true,\n  \"include_raw_content\": false,\n  \"max_results\": 5\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "7f09312b-bc66-419b-a016-1f7c7569e002",
      "name": "Query Tavily API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        340
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are an expert research analyst. You will be provided with research request parameters (topic, subtopics, description) and Tavily web search results. Generate an HTML-only research report utilizing semantic tags like <h1>, <h2>, and unordered lists (<ul>, <li>). Do not output markdown code blocks (no ```html), <html>, or <body> wrapper tags. Return only the clean, semantic HTML markup for the report."
            },
            {
              "role": "user",
              "content": "=Original Form Request:\n- Topic: {{ $('Webhook Trigger').item.json.body?.topic || $('Webhook Trigger').item.json.topic }}\n- Subtopics: {{ $('Webhook Trigger').item.json.body?.subtopics || $('Webhook Trigger').item.json.subtopics }}\n- Description: {{ $('Webhook Trigger').item.json.body?.description || $('Webhook Trigger').item.json.description }}\n- Reviewer Email: {{ $('Webhook Trigger').item.json.body?.reviewer_email || $('Webhook Trigger').item.json.reviewer_email }}\n\nTavily JSON Response:\n{{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3
        }
      },
      "id": "e3a89045-3162-4dc2-b34e-8392178ad003",
      "name": "LLM Generate Report",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.4,
      "position": [
        780,
        340
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Webhook Trigger').item.json.body?.reviewer_email || $('Webhook Trigger').item.json.reviewer_email }}",
        "subject": "=Research Report: {{ $('Webhook Trigger').item.json.body?.topic || $('Webhook Trigger').item.json.topic }}",
        "emailType": "html",
        "message": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #1e293b;\">\n  <div style=\"background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #10b981; padding: 14px 18px; margin-bottom: 24px; border-radius: 4px;\">\n    <p style=\"margin: 0; font-weight: 600; color: #0f172a;\">Instructions:</p>\n    <p style=\"margin: 4px 0 0 0;\">Please review this report and reply with either 'APPROVED' or 'FEEDBACK: [comments]'.</p>\n  </div>\n  \n  {{ $json.reportHtml || $json.message?.content || $json.text }}\n</div>",
        "options": {}
      },
      "id": "8b9a1234-5678-49ab-cdef-0123456789ab",
      "name": "Send Gmail to Reviewer",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1040,
        340
      ]
    }
  ],
